# API-Keys fuer die LLM-Provider. Mindestens einer muss gesetzt sein.
# Niemals .env committen — steht in .gitignore.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Optional: Port fuer den lokalen Server (Default 3111)
PORT=3111

# HOST=0.0.0.0 macht den Server im WLAN erreichbar (fuers iPhone).
# Weglassen oder 127.0.0.1 = nur lokal.
HOST=127.0.0.1
