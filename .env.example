# Vorlage: kopieren nach .env.local (wird nie eingecheckt) und ausfüllen.

# Home Assistant – Token: Profil (unten links) → Sicherheit → Langlebiges Zugriffstoken erstellen
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Für "node tools/ha.mjs deploy": SSH über das Add-on „Terminal & SSH“
# (dort unter Konfiguration deinen öffentlichen SSH-Schlüssel eintragen)
HA_SSH=root@homeassistant.local
HA_SSH_PORT=22

# Geräte-IPs – "node tools/geraete.mjs suchen" findet sie
GOE_IP=
ENVOY_IP=
# nur Envoy-Firmware ab 7: Token von https://entrez.enphaseenergy.com
ENVOY_TOKEN=
ACTHOR_IP=

# Oberfläche im Entwicklungsmodus (cd jotunland/frontend && npm run dev) – nur dort benutzt
VITE_HA_URL=http://homeassistant.local:8123
VITE_HA_TOKEN=
